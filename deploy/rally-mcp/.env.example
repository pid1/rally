# Copy to .env next to docker-compose.yml. Never commit the real file.

# The public hostname Cloudflare routes to rally-mcp, and your Zero Trust team
# domain (both as in deploy/cloudflare/config.toml).
RALLY_MCP_PUBLIC_HOST=rally-mcp.example.com
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com

# Cloudflare Tunnel token for the remotely managed tunnel "rally-mcp".
# deploy/cloudflare/configure.py writes it to ~/.config/cloudflare/rally-mcp-tunnel.token.
TUNNEL_TOKEN=

# The Access application's AUD tag (printed by deploy/cloudflare/configure.py,
# also under Zero Trust > Access > Applications > rally-mcp > Overview).
CF_ACCESS_AUD=

# Shared secret between rally-mcp and Rally. Generate once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and set the SAME value as RALLY_MCP_SERVICE_TOKEN on the Rally container.
RALLY_MCP_SERVICE_TOKEN=

# Optional: run a local build instead of ghcr.io/pid1/rally-mcp:latest.
# RALLY_MCP_IMAGE=rally-mcp:feature-rally-mcp
